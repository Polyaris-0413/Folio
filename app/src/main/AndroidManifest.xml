<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11+ 包可见性:声明对 TTS 服务的可见性,否则 TextToSpeech 找不到系统引擎,
         初始化返回 status=-1(照搬 Legado 的做法) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- 朗读前台服务:常驻通知(Android 13+ 运行时权限)+ 前台服务(Android 14+ 需媒体播放类型权限) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- AI 功能(LlmClient 调 OpenAI 兼容 API) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".FolioApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Folio">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Folio"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.licenses.LicensesActivity"
            android:exported="false"
            android:theme="@style/Theme.Folio" />

        <activity
            android:name=".ui.library.LibraryAddActivity"
            android:exported="false"
            android:theme="@style/Theme.Folio" />

        <activity
            android:name=".ui.reader.ReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.Folio" />

        <activity
            android:name=".ui.reader.TocActivity"
            android:exported="false"
            android:theme="@style/Theme.Folio" />

        <service
            android:name=".ui.reader.ReaderTtsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>